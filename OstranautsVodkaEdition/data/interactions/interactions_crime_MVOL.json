[
  {
    "strName": "ENCHeatMVOLBustedStart",
    "strTitle": "Пойманный",
    "strDesc": "Они доставляют вас к мировому судье Синьхуа для вынесения приговора, оставляя ваш корабль и снаряжение.\n\nНа слушании вы можете просить всего лишь о штрафе - 15 000 долларов, выплачиваемых полностью или частями, - или отправиться на гауптвахту «Вольтер» на год или три каторжных работ.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMVOLFineEnd",
      "ENCHeatMVOLFineDebtEnd",
      "ENCHeatMVOLPrisonStart"
    ],
    "fDuration": 0.0,
