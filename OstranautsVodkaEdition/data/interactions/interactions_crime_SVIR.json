[
  {
    "strName": "ENCHeatSVIRBustedStart",
    "strTitle": "Пойманный",
    "strDesc": "Они доставляют вас к военному судье Титана для вынесения приговора, оставляя ваш корабль и снаряжение.\n\nНа слушании вы можете просить всего лишь о штрафе - 15 000 долларов, выплачиваемых полностью или частями, - или отправиться на тюрьму «Вирджиния» на год или три каторжных работ.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatSVIRFineEnd",
      "ENCHeatSVIRFineDebtEnd",
      "ENCHeatSVIRPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
