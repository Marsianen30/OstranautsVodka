[
  {
    "strName": "ENCHeatMHNGBustedStart",
    "strTitle": "Пойманный",
    "strDesc": "Они доставляют вас к ханчжоускому мировому судье для вынесения приговора, оставляя ваш корабль и снаряжение.\n\nНа слушании вы можете просить всего лишь о штрафе - 15 000 долларов, выплачиваемых полностью или частями, - или отправиться на гауптвахту «Тарсис-Лэндинг» на год или три каторжных работ.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMHNGFineEnd",
